# Set font and colors
theme = "Catppuccin Mocha"
font-family = "JetBrainsMono Nerd Font"
font-size = 14
mouse-hide-while-typing = true
window-decoration = true
window-padding-x = 14
window-padding-y = 14
#background-opacity = 0.9
background-blur-radius = 20

# Enable keybinds
keybind = ctrl+shift+t=new_split:up
