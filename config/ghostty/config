# XDG_CONFIG_HOME is set in nu.sh to keep this file portable.

# Set font and colors
theme = "Catppuccin Mocha"
font-family = "JetBrains Mono"
font-size = 16
mouse-hide-while-typing = true
window-decoration = true
macos-option-as-alt = true
#background-opacity = 0.9
background-blur-radius = 20

command = /bin/bash -lc "exec \"$HOME/.config/ghostty/nu.sh\""

# Enable keybinds
keybind = ctrl+shift+t=new_split:up
